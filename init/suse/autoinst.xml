        <source><![CDATA[
#!/bin/sh

#depmod -a ; modprobe btrfs
#depmod -a ; modprobe dm-mod ; modprobe dm-crypt
#depmod -a ; modprobe ext4 xfs

init_hostname=$(cat /etc/hostname)
sed -i '/^127.0.1.1/ s|127.0.1.1|#127.0.1.1|' /etc/hosts
echo "127.0.1.1   ${init_hostname}.localdomain  ${init_hostname}" >> /etc/hosts

. /etc/os-release

MIRROR=${MIRROR:-download.opensuse.org}
if [ "opensuse-tumbleweed" = "${ID}" ] ; then
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/tumbleweed/repo/oss/ repo-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/tumbleweed/repo/non-oss/ repo-non-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/update/tumbleweed/ update-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/update/tumbleweed-non-oss/ update-non-oss
elif [ "opensuse-slowroll" = "${ID}" ] ; then
  zypper --non-interactive --root /mnt --gpg-auto-import-keys addrepo http://${MIRROR}/slowroll/repo/oss/ repo-oss
  zypper --non-interactive --root /mnt --gpg-auto-import-keys addrepo http://${MIRROR}/slowroll/repo/non-oss/ repo-non-oss
  zypper --non-interactive --root /mnt --gpg-auto-import-keys addrepo http://${MIRROR}/update/slowroll/repo/oss/ update-oss
  #zypper --non-interactive --root /mnt --gpg-auto-import-keys addrepo http://${MIRROR}/update/slowroll/repo/non-oss/ update-non-oss # ???
else # elif [ "opensuse-leap" = "${ID}" ] ; then
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/distribution/leap/${VERSION_ID}/repo/oss/ repo-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/distribution/leap/${VERSION_ID}/repo/non-oss/ repo-non-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/update/leap/${VERSION_ID}/oss/ update-oss
  zypper --non-interactive --gpg-auto-import-keys addrepo http://${MIRROR}/update/leap/${VERSION_ID}/non-oss/ update-non-oss
fi

zypper repos ; sleep 5

#cp -a /usr/share/systemd/tmp.mount /etc/systemd/system/
#systemctl enable tmp.mount
echo "tmpfs                           /tmp        tmpfs   defaults,nosuid,nodev,mode=1777   0   0" >> /etc/fstab

#systemctl enable sshd ; systemctl stop sshd
systemctl disable firewalld


groupadd --system wheel
usermod -aG wheel packer
mkdir -m 0700 -p /home/packer/.ssh ; chown -R packer /home/packer

sudoers_base=/etc/sudoers
#if [ -e "/usr/etc/sudoers" ] ; then
#  sudoers_base=/usr/etc/sudoers ;
#fi
echo "@includedir ${sudoers_base}.d" >> ${sudoers_base}
mkdir -p ${sudoers_base}.d
#echo "#Defaults:packer !requiretty" >> ${sudoers_base}.d/99_packernopasswd
#echo "packer ALL=(ALL:ALL) NOPASSWD: ALL" >> ${sudoers_base}.d/99_packernopasswd
#chmod 0440 ${sudoers_base}.d/99_packernopasswd

echo "#Defaults:%wheel !requiretty" >> ${sudoers_base}.d/99_wheelnopasswd
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" >> ${sudoers_base}.d/99_wheelnopasswd


echo 'GRUB_PRELOAD_MODULES="btrfs"' >> /etc/default/grub
#echo 'GRUB_PRELOAD_MODULES="lvm"' >> /etc/default/grub

sed -ie '/^GRUB_CMDLINE_LINUX_DEFAULT/ s|^\(.*\)$|#\1\n\1|' /etc/default/grub
sed -ie '/^GRUB_CMDLINE_LINUX_DEFAULT/ s|="\(.*\)"|="\1 rootdelay=5"|' \
  /etc/default/grub
#grub2-install --target=i386-pc --recheck /dev/[sv]da
if [ "$(dmesg | grep -iE 'kvm|qemu|hypervisor')" ] ; then
  sed -ie '/^GRUB_CMDLINE_LINUX_DEFAULT/ s|="\(.*\)"|="\1 net.ifnames=0 biosdevname=0"|' /etc/default/grub ;
fi
grub2-mkconfig -o /boot/grub2/grub.cfg


zypper --non-interactive clean
fstrim -av
sync
]]></source>
      </script>
